# Ask Your Factory: what stays out of git.
# Rule of thumb: secrets, anything machine-specific or regenerable, and anything over ~25 MB
# that a clone can rebuild. Add a negation (!) next to the rule that would hide a tracked file.

# ==============================================================================
# Secrets & local configuration (never commit)
# ==============================================================================
.env
.env.*
!.env.example
!.env.template
*.env
# Machine-specific uv cache paths (also matched by *.env; listed so the intent is explicit)
backend/pythonpath.env
*.secret
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
# MCP server config; holds API-key slots
.mcp.json

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
.eggs/
.installed.cfg
MANIFEST
# Anchored: bare `build/`, `dist/` or `lib/` would also hide frontend folders of that name
/backend/build/
/backend/dist/

# ==============================================================================
# Virtual environments & toolchains (the backend .venv alone is ~6 GB: torch, ultralytics)
# ==============================================================================
.venv/
venv/
env/
ENV/
.uv/
.conda/
.direnv/
# .python-version is deliberately NOT ignored: commit it so `uv` picks the same Python everywhere

# ==============================================================================
# Frontend tooling (the viewer is plain files today; this covers adding a bundler later)
# ==============================================================================
node_modules/
npm-debug.log*
.eslintcache
*.tgz

# ==============================================================================
# Tests, coverage & linters
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
/coverage/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# ==============================================================================
# Runtime state & logs (regenerated on start)
# ==============================================================================
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.log
logs/
tmp/
temp/
.cache/

# ==============================================================================
# Data, scans & models
# ==============================================================================
# Raw and variant scans stay local; only the two derived viewer files are tracked
# (they let a fresh clone run without the 355 MB source splat).
data/*.ply
!data/Industrial_Boiler_Room_standard.ply
!data/Industrial_Boiler_Room_mesh.ply
Valmet challenge data/

# Weights: block stray downloads (YOLO-World pulls CLIP ViT-B-32.pt etc. into the working
# directory); the one detector the demo needs is tracked on purpose.
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
!backend/yolov8s-worldv2.pt

# Archives and screen recordings belong on the submission portal, not in the repo
*.zip
*.7z
*.tar
*.tar.gz
*.mp4
*.mov
*.mkv
*.webm

# Phone photos and screenshots of briefs / grading slides
data/grading.*

# ==============================================================================
# AI assistants & tool scratch space
# ==============================================================================
.agents/
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
Claude outputs/
.playwright-mcp/

# ==============================================================================
# Editors, OS & merge leftovers
# ==============================================================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
