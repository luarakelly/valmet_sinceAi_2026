# sitecustomize.py - automatically configure environment and uv archives
import glob
import sys
from pathlib import Path

# Exclude older conflicting pydantic (2.13.5) and 313-only wheels and numpy (use system numpy)
excluded = ['9xUMZ89EsXOQ04jr', 'myndMncpNCwBiYFO', 'uupj1CyNSAKeNpeZ', 'I11vM_3KcEPfn0RZ']
archives = []
for p in glob.glob('/home/veiston/.cache/uv/archive-v0/*'):
    if any(x in p for x in excluded):
        continue
    if (Path(p) / 'numpy').exists():
        continue
    archives.append(p)

priority = ['/home/veiston/.cache/uv/archive-v0/UWrUVIkq7nVlnLku', '/home/veiston/.cache/uv/archive-v0/cEBDv3EkLMb8f0-_']
archives = priority + [a for a in sorted(archives) if a not in priority]

for a in reversed(archives):
    if a not in sys.path:
        sys.path.insert(0, a)
